  "pull_mirror": {
    "reusable_workflow": "guedesle/SKILLS/.github/workflows/mirror-consumer.yml@main",
    "consumer_workflow": ".github/workflows/sync-central-skills.yml",
    "default_schedule": "17 * * * *"
  },
  "policy": {
    "central_is_source_of_truth": true,
    "general_skills_must_be_registered": true,
    "project_specific_skills_are_not_auto_promoted": true,
    "mirror_updates_are_non_destructive_outside_managed_paths": true,
    "prefer_pull_mirrors_when_central_repository_is_public": true,
    "consumer_workflow_is_generic_per_repository": true,
    "deterministic_failures_do_not_require_hitl": true,
    "declared_evals_do_not_imply_model_execution": true
  },
  "runtime_adapters": {
    "codex": {
      "routing_skill": "adaptive-model-routing",
      "family": "gpt-5.6",
      "defaults": {
        "bounded_execution_leaf": {"model": "gpt-5.6-luna", "reasoning_effort": "high"},
        "context_handoff_orchestration": {"model": "gpt-5.6-terra", "reasoning_effort": "medium"},
        "frontier_reasoning_high_complexity": {"model": "gpt-5.6-sol", "reasoning_effort": "high"}
      },
      "policy": {
        "start_with_minimum_sufficient_tier": true,
        "escalate_on_material_complexity": true,
        "deescalate_after_scope_is_closed": true,
        "model_capability_does_not_expand_authority": true,
        "explicit_user_or_host_policy_overrides_defaults": true
      }
    }
  },
